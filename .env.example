# ==============================================================================
# SIH Smart Tourism Backend - Environment Configuration Template
# ==============================================================================

# Server Configuration (Optional, defaults provided)
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# CORS Configuration (Optional, defaults to * in development)
CORS_ORIGIN=*
# In production, set FRONTEND_ORIGINS to comma-separated allowed URLs
# FRONTEND_ORIGINS=https://sih-tourism.gov.in,https://app.sih-tourism.gov.in

# Supabase Database Configuration
# SUPABASE_URL: URL of your Supabase project (Required for live DB)
SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY: Client/Anon key (Optional for client requests)
SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY: Backend Service Role Key (Required for admin/bypass RLS backend operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider Configuration (Optional - fallback to Deterministic Grounded Provider if omitted)
# GEMINI_API_KEY: Google Gemini AI API Key
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL_NAME=gemini-1.5-flash
AI_MAX_OUTPUT_TOKENS=2048

# Google Stitch UI / MCP Configuration (Optional)
# STITCH_API_KEY: API Key from stitch.withgoogle.com settings
# STITCH_API_KEY=your-stitch-api-key


